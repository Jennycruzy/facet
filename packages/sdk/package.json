{
  "name": "@facet/sdk",
  "version": "0.1.0",
  "description": "Facet's dapp-facing action builder over the Starknet privacy SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jennycruzy/facet.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Jennycruzy/facet/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/Jennycruzy/facet/issues"
  },
  "keywords": ["starknet", "privacy", "defi", "wallet", "sdk"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "examples"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:browser": "npm run build && node scripts/build-browser-bundle.mjs",
    "test": "vitest run",
    "check": "npm run build && npm run check:examples && npm test",
    "check:examples": "tsc --noEmit -p examples/tsconfig.json",
    "gate-a:preflight": "node scripts/gate-a-avnu-preflight.mjs",
    "gate-a:run": "node scripts/gate-a-sepolia.mjs",
    "gate-a:selfhost:preflight": "node scripts/gate-a-selfhost.mjs preflight",
    "gate-a:selfhost:run": "node scripts/gate-a-selfhost.mjs run",
    "gate-a:test-pool": "node scripts/gate-a-test-pool-setup.mjs",
    "gate-a:pool-upgrade": "node scripts/gate-a-pool-upgrade-rc5.mjs",
    "gate-c:ekubo": "node scripts/gate-c-ekubo.mjs",
    "contracts:deploy:mainnet": "node scripts/deploy-facet-mainnet.mjs",
    "contracts:deploy:ekubo-helper": "node scripts/deploy-ekubo-helper-mainnet.mjs",
    "contracts:deploy:defi-helpers": "node scripts/deploy-defi-helpers-mainnet.mjs",
    "gate-a:paymaster-setup": "node scripts/gate-a-selfhost-paymaster-setup.mjs",
    "paymaster:refresh": "node scripts/gate-a-selfhost-paymaster-refresh.mjs",
    "paymaster:topup": "node scripts/gate-a-selfhost-paymaster-topup.mjs",
    "paymaster:relayer-fund": "node scripts/gate-a-selfhost-paymaster-relayer-fund.mjs",
    "private:sepolia:preflight": "node scripts/gate-a-avnu-preflight.mjs",
    "private:sepolia:run": "node scripts/gate-a-sepolia.mjs",
    "private:sepolia:selfhost:preflight": "node scripts/gate-a-selfhost.mjs preflight",
    "private:sepolia:selfhost:run": "node scripts/gate-a-selfhost.mjs run",
    "private:pool:setup": "node scripts/gate-a-test-pool-setup.mjs",
    "private:paymaster:setup": "node scripts/gate-a-selfhost-paymaster-setup.mjs",
    "private:paymaster:refresh": "node scripts/gate-a-selfhost-paymaster-refresh.mjs",
    "private:paymaster:topup": "node scripts/gate-a-selfhost-paymaster-topup.mjs",
    "private:paymaster:relayer-fund": "node scripts/gate-a-selfhost-paymaster-relayer-fund.mjs",
    "private:defi:ekubo": "node scripts/gate-c-ekubo.mjs"
  },
  "peerDependencies": {
    "@starkware-libs/starknet-privacy-sdk": "^0.14.3-rc.5"
  },
  "peerDependenciesMeta": {
    "@starkware-libs/starknet-privacy-sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "starknet": "10.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
