# Copy to .env in this directory. Compose reads it automatically, so up, down and logs
# all work without exporting anything into your shell.

# A Starknet RPC endpoint speaking v0.10. The prover needs storage proofs from it, and
# providers differ — see docs/PROVER.md for which ones work.
RPC_URL=https://rpc.vauban.tech/rpc/v0_10

# Override if you built your own image for a different CPU target.
# PROVER_IMAGE=transaction-prover:local

# Keep this under your free memory. One proof peaked at 6.67 GiB on the reference host.
# PROVER_MEM_LIMIT=7g
