# Copy to .env and fill in. Never commit .env.

# Starknet mainnet RPC.
# Free public endpoints that work without a key:
#   https://api.cartridge.gg/x/starknet/mainnet
#   https://rpc.starknet.lava.build:443
# Note: starknet-mainnet.public.blastapi.io is retired and returns an error.
STARKNET_MAINNET_RPC=

# Starknet Sepolia RPC, used for rehearsal before any mainnet transaction.
STARKNET_SEPOLIA_RPC=

# Account used to send transactions. Address only — see below for the key.
STARKNET_ACCOUNT_ADDRESS=

# Private key for the account above.
# Keep this in .env only. It is never read back, logged, or committed.
STARKNET_PRIVATE_KEY=
